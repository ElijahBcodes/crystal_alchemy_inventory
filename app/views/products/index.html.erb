
<div class="w-full bg-gradient-to-r from-yellow-600 via-blue-600 to-purple-600">
 
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-100 mb-5 text-green-700 font-medium rounded-lg inline-block">
        <%= notice %>
      </p>
    <% end %>

    <% content_for :title, "Crystal Alchemy" %>

    <h1 class="text-6xl font-bold  bg-clip-text text-white mb-8 text-center">
      Products
    </h1>

<div id="products" class="min-w-full grid md:grid-cols-4 gap-8 ">
  <% @products.each do |product| %>
    <%= render product %>
  <% end %>
</div>

</div>
