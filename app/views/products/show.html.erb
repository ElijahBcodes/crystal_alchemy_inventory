<div class="min-h-screen bg-linear-to-br from-purple-100 via-blue-50 to-purple-50">
  <div class="w-full max-w-4xl mx-auto px-4 py-8">
  
    <div class="max-w-7xl w-full mx-auto px-10 mb-2"> 
    <%= link_to "Products", products_path, class: "text-xl text-gray-100 hover:text-gray-200" %>
    <%= link_to "> #{@product.name}", @product, class: "text-xl text-gray-100" if @product %>
    <%= link_to "> #{@product}", @product, class: "text-xl text-gray-100" %>
  </div>

    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-100 mb-5 text-green-700 font-medium rounded-lg inline-block"> <%= notice %></p>
    <% end %>

    <div class="grid grid-cols-2">
      <div></div>
      
    </div>





<% if current_admin %>
    <div class="flex flex-wrap gap-4 items-center">
      <%= link_to "Edit this product", edit_product_path(@product), class: "inline-block px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition" %>
      <%= link_to "Back to products", products_path, class: "inline-block px-6 py-3 bg-gray-600 text-white font-semibold rounded-lg hover:bg-gray-700 transition" %>
      <%= button_to "Destroy this product", @product, method: :delete, class: "px-6 py-3 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition", form: { data: { turbo_confirm: "Are you sure?" } } %>
    </div>
<% end %>
  </div>
</div>